# AXIOM environment configuration (copy to .env; never commit real secrets)

# Anthropic API key for the reasoning layer. The deterministic quant engine,
# the test suite, and `cli ... --stub-llm` all run WITHOUT this key.
ANTHROPIC_API_KEY=

# Model id for the reasoning layer (defaults to a current Claude model).
AXIOM_LLM_MODEL=claude-opus-4-8

# Path to the SQLite audit database.
AXIOM_DB_PATH=axiom.db

# Risk profile: CONSERVATIVE | BALANCED | AGGRESSIVE (operator default: AGGRESSIVE)
AXIOM_RISK_PROFILE=AGGRESSIVE
